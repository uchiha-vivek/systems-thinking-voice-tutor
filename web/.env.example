# Copy to web/.env.local for local development. On Vercel, set ELEVENLABS_AGENT_ID in
# Project Settings -> Environment Variables (the API key is not needed there).
ELEVENLABS_AGENT_ID=
# Only used by `npm run setup-agent`, which you run from your own machine.
ELEVENLABS_API_KEY=
# After-session feedback (optional). Set both on Vercel too; see "Feedback sheet" in the README.
FEEDBACK_SHEET_URL=
FEEDBACK_SECRET=
